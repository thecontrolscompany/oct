# SQL Server credentials (create a dedicated SQL login with db_datareader on CCT_DB and FDB_Control_10_8___Firmware_12_0)
# Windows Auth via named pipes works; TCP requires a SQL login.
CCT_DB_SERVER=localhost
CCT_DB_USER=your-sql-login
CCT_DB_PASSWORD=your-sql-password

# Paths to JCI CCT installation directories (defaults match a standard CCT install)
PACKAGES_DIR=C:\ProgramData\Johnson Controls\MetasysIII\Field Controller Packages
PERSPECTIVES_DIR=C:\CCT\Controller Config Tool - CCT (New)\Controller Configuration Tool (CCT)\Controller Configuration Tool (CCT)\Perspectives
TEMPLATES_DIR=C:\CCT\Controller Config Tool - CCT (New)\Controller Configuration Tool (CCT)\Controller Configuration Tool (CCT)\AttributeTemplates

# CORS: comma-separated list of allowed origins for cross-origin requests.
# Leave unset (or omit) during local development — all origins are allowed.
# Set to your Vercel deployment URL in production.
# CORS_ORIGINS=https://oct.trimrespond.com,http://localhost:5173
